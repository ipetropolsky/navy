# Настройки сборки. Скопируйте в .env.local (он в .gitignore) и подставьте свои значения.
#
# Ничего секретного здесь нет: всё, что начинается на VITE_, уезжает в бандл к каждому,
# кто откроет страницу, и спрятать это невозможно в принципе. Файл отдельный не ради тайны,
# а ради того, что у разных людей и у выкладки значения разные.
#
# Значения берутся в консоли Firebase: Project settings → Your apps → веб-приложение →
# SDK setup and configuration → Config. Оттуда же они попадают на GitHub:
# Settings → Secrets and variables → Actions, вкладка Variables. Сборка заглядывает в обе
# вкладки (`vars.X || secrets.X`, см. .github/workflows/deploy.yml), так что в Secrets она их
# тоже найдёт, — но место им в Variables: секрет их не спрячет, а в логе сборки замажет.

# Какой бэкенд собирать: local (по умолчанию) или firebase.
#
# Написали firebase — значит, ключи ниже обязаны быть: без них сборка откажется
# (см. vite.config.ts). Так и должно быть — молча собранная версия на localStorage
# выглядит целой, но она без входа и без общей базы.
VITE_BACKEND=firebase

# Ходить в эмуляторы (Firestore, Auth, функции) вместо настоящего проекта.
# Ключи при этом не нужны: эмулятор принимает любые.
# VITE_FIREBASE_EMULATOR=1

# Настройки проекта. Обязательны при VITE_BACKEND=firebase без эмулятора.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=

# Домен входа. Без него окно входа уйдёт не туда: именно этот адрес перечисляется
# в Authentication → Settings → Authorized domains.
VITE_FIREBASE_AUTH_DOMAIN=

VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Поддельный Google-токен, которым входят проверки поверх эмуляторов (npm run test:e2e:firebase).
#
# Настоящий вход открывает окно, а окну всегда нужен gapi с apis.google.com — там, где выхода
# к хостам Google нет, оно до выбора аккаунта не доходит. Эмулятор Auth принимает вместо
# подписанного JWT обычный JSON и заводит по нему настоящего пользователя с providerId
# google.com, и проверки входят так.
#
# Секрета тут нет: за пределами эмулятора такой токен не примет никто. Задавать не обязательно —
# без него берётся то же значение по умолчанию (GOOGLE_ID_TOKEN в tests-firebase/env.ts).
# Переопределяют, когда проверке нужна другая личность: другой домен почты, лишние поля.
#
# Поля sub, name и почту подставляет сама проверка — они у каждой свои. Почту обязательно:
# по ней Firebase сводит аккаунты, и одна на всех склеила бы две вкладки в одного человека.
# Из значения ниже в почту идёт только домен.
# E2E_GOOGLE_ID_TOKEN={"email":"skipper@example.com","email_verified":true}
